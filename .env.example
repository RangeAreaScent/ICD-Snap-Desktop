# Apple credentials for signing + notarizing ICD Snap Desktop release builds.
# Copy to .env and fill in (gitignored). See HANDOFF.md §6.5.
# Same DOIE LLC team + Developer ID Application cert + App Store Connect
# API key as mMDd and PasteLight — copy the real values from
# ~/Projects/mMDd/.env rather than generating new ones.
#
# NOTE: Tauri's env var names differ from electron-builder's (used by
# mMDd/PasteLight) even though the values are the same credentials:
#   - Tauri's APPLE_API_KEY is the Key ID (short string).
#   - electron-builder's APPLE_API_KEY is the .p8 file PATH — that value
#     goes in Tauri's APPLE_API_KEY_PATH instead.
# Mixing these up silently breaks notarization. Double-check before copying.

# Full identity string as shown by `security find-identity -v -p codesigning`
# (WITH the "Developer ID Application: " prefix — unlike electron-builder
# v25, which rejects that prefix in package.json's build.mac.identity).
APPLE_SIGNING_IDENTITY="Developer ID Application: DOIE LLC (8636DYWLSV)"

# Team ID for notarization.
APPLE_TEAM_ID="8636DYWLSV"

# UUID Issuer ID shown at the top of the App Store Connect API Keys page.
# Same value as ~/Projects/mMDd/.env's APPLE_API_ISSUER.
APPLE_API_ISSUER="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# 10-character Key ID shown next to the key in App Store Connect.
# Same value as ~/Projects/mMDd/.env's APPLE_API_KEY_ID.
APPLE_API_KEY="XXXXXXXXXX"

# Absolute path to the .p8 API key downloaded from App Store Connect.
# Same file as ~/Projects/mMDd/.env's APPLE_API_KEY (the path, not the ID).
APPLE_API_KEY_PATH="/path/to/AuthKey_XXXXXXXXXX.p8"
